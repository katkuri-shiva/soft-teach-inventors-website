@{
    ViewData["Title"] = "About";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- =========================================
    ABOUT SECTION US START
========================================= -->
<section class="about-section">

    <div class="container">

        <div class="row align-items-center">

            <!-- LEFT IMAGE -->

            <div class="col-lg-6">

                <div class="about-image">
                    <img src="/images/slide2.png" alt="About Image"/>
                </div>

            </div>

            <!-- RIGHT CONTENT -->

            <div class="col-lg-6">

                <div class="about-content">

                    <h2>About Us</h2>

                    <p>
                        Soft Teach Inventors provides joyful learning experiences, interactive books, creative learning programs, technology education, and future-ready skill development for young learners.
                    </p>

                    <!-- ITEM 1 -->

                    <div class="about-item">
                        <h4>💡 Creative Learning</h4>

                        <p>
                            Fun-filled activities, imagination, creativity and skill development for young learners.
                        </p>
                    </div>

                    <!-- ITEM 2 -->

                    <div class="about-item">
                        <h4>🏆 Future Ready Skills</h4>

                        <p>
                            Building creativity, confidence and essential skills for tomorrow's world.Strong conceptual learning programs for future achievers.
                        </p>
                    </div>

                    <!-- ITEM 3 -->

                    <div class="about-item">
                        <h4>💻 Technology Learning</h4>

                        <p>
                            Introducing young minds to coding, digital literacy and innovative thinking.
                        </p>
                    </div>

                </div>

            </div>

        </div>

    </div>

</section>

<!-- =========================================
    ABOUT US SECTION END
========================================= -->

<!-- =====================================================
     FOUNDER MESSAGE SECTION START
===================================================== -->

<section class="founder-section">

    <div class="founder-title">
        <h2>Message From Founder</h2>
        <p>Building Future Ready Learning Resources</p>
    </div>

    <div class="founder-content">

        <div class="founder-image">
            <img src="~/images/team9.jpg" alt="Founder">
        </div>

        <div class="founder-text">

            <h3>Welcome to Soft Teach Inventors</h3>

            <p>
                At Soft Teach Inventors, our mission is to create innovative
                educational books that inspire creativity, critical thinking
                and lifelong learning.
            </p>

            <p>
                We are committed to supporting schools, teachers and students
                with high-quality educational resources designed for modern
                classrooms and future-ready learning.
            </p>

            <p>
                Thank you for being a part of our educational journey.
            </p>

            <a href="#contact" class="founder-btn">
                Read More
            </a>

        </div>

    </div>

</section>

<!-- =====================================================
     FOUNDER MESSAGE SECTION END
===================================================== -->

<!-- ==========================================
     MEET OUR TEAM SECTION START
========================================== -->

<section class="team-section">

    <div class="team-title">
        <h2>Meet Our Team</h2>
        <p>The passionate people behind Soft Teach Inventors</p>
    </div>

    <div class="team-container">

        <div class="team-card">
            <img src="/images/team9.jpg" alt="Team Member">
            <h3>Founder & Director</h3>
            <p>Leading innovation in educational publishing.</p>
        </div>

        <div class="team-card">
            <img src="/images/team2.jpg" alt="Team Member">
            <h3>Content Specialist</h3>
            <p>Designing engaging learning experiences.</p>
        </div>

        <div class="team-card">
            <img src="/images/team3.jpg" alt="Team Member">
            <h3>Creative Designer</h3>
            <p>Creating visually appealing educational content.</p>
        </div>

    </div>

</section>

<!-- ==========================================
     MEET OUR TEAM SECTION END
========================================== -->
<!-- ==========================================
     OUR VISION & MISSION START
========================================== -->

<section class="vision-section">

    <div class="vision-title">

        <h2>Our Vision & Mission</h2>

        <p>
            Building a brighter future through quality education and innovation.
        </p>

    </div>

    <div class="vision-container">

        <div class="vision-card">

            <i class="fas fa-eye"></i>

            <h3>Our Vision</h3>

            <p>
                To become a leading educational publishing company that inspires
                students, teachers and schools through innovative learning resources.
            </p>

        </div>

        <div class="vision-card">

            <i class="fas fa-bullseye"></i>

            <h3>Our Mission</h3>

            <p>
                To create engaging, practical and future-ready educational content
                that empowers learners and supports institutions.
            </p>

        </div>

    </div>

</section>

<!-- ==========================================
     OUR VISION & MISSION END
========================================== -->
<!-- =========================================

     COUNTER SECTION START
========================================= -->

<section class="counter-section">

    <div class="counter-container">

        <div class="counter-box">
            <h2>5000+</h2>
            <p>Students</p>
        </div>

        <div class="counter-box">
            <h2>1000+</h2>
            <p>Schools</p>
        </div>

        <div class="counter-box">
            <h2>250+</h2>
            <p>Teachers</p>
        </div>

        <div class="counter-box">
            <h2>10+</h2>
            <p>Years Experience</p>
        </div>

    </div>

</section>

<!-- =========================================
     COUNTER SECTION END
========================================= -->
