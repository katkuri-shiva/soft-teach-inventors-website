<!-- =========================================
    FAQ SECTION START
========================================= -->
<section class="faq-section">

    <div class="faq-title">
        <h2>Frequently Asked Questions</h2>
        <p>Get answers to common questions</p>
    </div>

    <div class="faq-container">

        <details>
            <summary>What programs do you offer?</summary>
            <p>We offer Coding, Robotics, AI, Abacus, Vedic Maths and Skill Development Programs.</p>
        </details>

        <details>
            <summary>Who can join these programs?</summary>
            <p>Students from Preschool to Higher Classes can join based on age and learning level.</p>
        </details>

        <details>
            <summary>Do you provide online classes?</summary>
            <p>Yes, we provide both online and offline learning options.</p>
        </details>

        <details>
            <summary>Do schools get special training?</summary>
            <p>Yes, we provide teacher training and school support programs.</p>
        </details>

        <details>
            <summary>How can I contact Soft Teach Inventors?</summary>
            <p>You can contact us through phone, WhatsApp or email.</p>
        </details>

    </div>

</section>
<!-- =========================================
    FAQ SECTION END
========================================= -->